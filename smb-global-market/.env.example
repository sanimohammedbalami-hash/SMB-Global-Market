# Frontend (safe to expose — these are public/anon keys)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# The variables below are SERVER-SIDE ONLY. Never put these in a .env that
# ships to the frontend, and never reference them with an import.meta.env
# call from React code. Set them as Supabase Edge Function secrets:
#
#   supabase secrets set PAYSTACK_SECRET_KEY=sk_xxx
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=xxx
#
# SUPABASE_URL is provided automatically to Edge Functions at runtime.
# ---------------------------------------------------------------------------
# PAYSTACK_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Public Paystack key, used only if you add a client-side Paystack popup
# in addition to the redirect flow already wired up. Safe to expose.
VITE_PAYSTACK_PUBLIC_KEY=
